41                                          !external_nface_dpdiam_z:       nz - number of cells in z direction

.false.                                     !external_bc_dpvel:             use external input file for boundary condition? - DPM_VEL
"externalBC/dpvel.txt"                      !external_bc_dpvel_filepath:    filepath
