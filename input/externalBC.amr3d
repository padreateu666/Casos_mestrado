!! externalbc input file. Readed in input_external_bc subroutine

!!!****External input files****!!!
.false.                                      !external_bc_vel: 				use external input file for boundary condition? - VELOCITIES (EULER-PHASE)
"externalBC/regular_mesh_velocities.txt"                  !external_bc_vel_filepath: 		filepath
81                                        !external_nface_vel_x:          nx - number of cells in x direction
81                                        !external_nface_vel_z:          nz - number of cells in z direction

.false.                                     !external_bc_temp:              use external input file for boundary condition? - TEMPERATURE
"externalBC/temperature.txt"                !external_bc_temp_filepath:     filepath
41                                          !external_nface_temp_x:         nx - number of cells in x direction
41                                          !external_nface_temp_z:         nz - number of cells in z direction

.false.                                     !external_bc_yk:                use external input file for boundary condition? - MASS FRACTION
"externalBC/yk.txt"                         !external_bc_yk_filepath:       filepath
41                                          !external_nface_yk_x:           nx - number of cells in x direction
41                                          !external_nface_yk_z:           nz - number of cells in z direction

.false.                                     !external_bc_dpdiam:            use external input file for boundary condition? - DPM_DIAMETER
"externalBC/dpdiam.txt"                     !external_bc_dpdiam_filepath:   filepath
